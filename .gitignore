# Build output: build.tcl concatenates src/ into this file, and the starkit
# wrap turns it into the executable.  Both are generated - never edit them.
/sotalog.tcl
/SOTALog
/SOTALog.exe
/SOTALog-*.app/

# Runtime files written next to the application by the user's own session.
/sotalog.conf
/sotalog.conf.new
/*.csv
/*.adi
/*.thm.new
/*.txt.new

# Test scratch, should any run ever write it here rather than under TEMP.
/sotalog-test-*/
/.testtmp/

# Editor and OS noise
.DS_Store
Thumbs.db
