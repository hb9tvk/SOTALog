# UTC entry mode: the operator types the time, and the date comes from the
# configured activation date rather than from the clock.  This needs its own
# file because logwindow builds a different set of widgets for it, and the
# window can only be built once per process.

set ::env(TZ) UTC
source [file join [file dirname [info script]] helpers.tcl]
namespace import ::tcltest::*
namespace import ::sotalogtest::*
loadModules
freezeClock 1757073930

set dir [sandbox]
startLogWindow $dir 1

# The window now opens with no band chosen; these tests are about what reaches
# the log files, so pick one as the operator would.
set ::sotalog::band 40m

test filenames-from-activation-date {the log is named for the configured date, not today} -body {
    list $::sotalog::logfile $::sotalog::adif
} -result {2026-09-05_HB_BE-003.csv 2026-09-05_HB_BE-003.adi}

test utc-widget-exists {entry mode adds a UTC field ahead of the call} -body {
    winfo exists .sotalog.utc
} -result 1

test csv-uses-typed-time {the typed time and the activation date reach the CSV} -body {
    logQso call OK1XYZ rsts 599 rstr 599 utc 0742
    string trim [readFile [file join $dir $::sotalog::logfile]]
} -result {V2,HB9TVK/P,HB/BE-003,05/09/2026,0742,7.0MHz,CW,OK1XYZ,,"RSTS:599 RSTR:599"}

test adif-uses-typed-time {and the ADIF record agrees} -body {
    lindex [adifRecords [file join $dir $::sotalog::adif]] 0
} -result {<CALL:6>OK1XYZ <MODE:2>CW <BAND:3>40m <QSO_DATE:8>20260905 <TIME_ON:6>074200 <RST_RCVD:3>599 <RST_SENT:3>599 <STATION_CALLSIGN:8>HB9TVK/P <OPERATOR:8>HB9TVK/P <MY_SOTA_REF:9>HB/BE-003 <EOR>}

test adif-header-uses-the-activation-date {the header carries the configured date, not today} -body {
    adifHeaderOf [file join $dir $::sotalog::adif]
} -result "ADIF export from SOTALog: HB9TVK/P at HB/BE-003 on 2026-09-05
<ADIF_VER:5>3.1.5
<PROGRAMID:7>SOTALog
<PROGRAMVERSION:[string length $::sotalog::SOTALOG_VERSION]>$::sotalog::SOTALOG_VERSION
<EOH>"

test reload-keeps-both-reports {a QSO with reports but no remark keeps its RSTr on reload
    This is the case that used to lose data: the parse required a space after
    the received report, so anything logged without a remark came back with an
    empty RSTr column.
} -setup {
    set ::sotalog::box {}
    initCounter
    .loghist.box delete 0 end
} -body {
    readLog
    string trim [lindex $::sotalog::box 0]
} -result {0742   OK1XYZ              599       599}

test reload-restores-band {readLog puts the band back where the last QSO was} -setup {
    set ::sotalog::box {}
    initCounter
    .loghist.box delete 0 end
    set ::sotalog::band 20m
} -body {
    readLog
    list $::sotalog::band $::sotalog::qsocount(40m) [llength $::sotalog::box]
} -result {40m 1 1}

# tcltest exits from cleanupTests with a zero status whatever happened, so
# tools/test.tcl decides pass or fail by reading the summary line below.
removeSandboxes
cleanupTests
