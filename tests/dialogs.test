# Where modal dialogs open.
#
# Show.Modal used to measure the dialog before the geometry manager had laid
# it out, so it centred on a size the dialog never had - about 200x200 for the
# configuration dialog, whatever it was part way through being built - and
# then applied two fixed offsets on top.  The configuration dialog landed
# partly below the main window, which matters on a small screen.

source [file join [file dirname [info script]] helpers.tcl]
namespace import ::tcltest::*
namespace import ::sotalogtest::*
loadModules

test clamp-leaves-a-fitting-window-alone {a window already on screen is not moved} -body {
    clampToScreen 100 200 1000
} -result 100

test clamp-pulls-back-from-the-far-edge {a window running off the right or bottom is pulled in} -body {
    list [clampToScreen 900 200 1000] [clampToScreen 999 200 1000]
} -result {800 800}

test clamp-never-goes-negative {a window larger than the screen starts at the edge} -body {
    list [clampToScreen -50 200 1000] [clampToScreen 100 2000 1000]
} -result {0 0}

# The rest needs a real, mapped main window to centre against.
set dir [sandbox]
freezeClock 1757073930
startLogWindow $dir 0
wm deiconify .
update

set ::sotalog::myCall HB9TVK/P
set ::sotalog::utcDate 06/09/2026
set ::sotalog::oneKeyReport 1
set ::sotalog::updated 0
set ::sotalog::cwd $dir

# Opens the configuration dialog, records where it landed, and cancels it.
proc dialogGeometry {} {
    after 400 {
        update idletasks
        set ::placement [list \
            [winfo rootx .cfg] [winfo rooty .cfg] \
            [winfo reqwidth .cfg] [winfo reqheight .cfg]]
        set ::sotalog::modalResult 0
    }
    configDialog
    return $::placement
}

test dialog-is-centred-on-the-main-window {the dialog opens over the window it belongs to} -body {
    lassign [dialogGeometry] x y w h
    set mainCentreX [expr {[winfo rootx .] + [winfo width .] / 2}]
    set mainCentreY [expr {[winfo rooty .] + [winfo height .] / 2}]
    set dialogCentreX [expr {$x + $w / 2}]
    set dialogCentreY [expr {$y + $h / 2}]
    # Integer division can leave a pixel in it; anything more is a real offset.
    list [expr {abs($dialogCentreX - $mainCentreX) <= 1}] \
         [expr {abs($dialogCentreY - $mainCentreY) <= 1}]
} -result {1 1}

test dialog-fits-inside-the-main-window {and does not hang off any edge of it
    The configuration dialog is smaller than the log window, so centring it
    should leave it entirely within.  It used to sit 71 pixels below the
    bottom.
} -body {
    lassign [dialogGeometry] x y w h
    set outside {}
    if {$x < [winfo rootx .]} { lappend outside left }
    if {$y < [winfo rooty .]} { lappend outside top }
    if {$x + $w > [winfo rootx .] + [winfo width .]} { lappend outside right }
    if {$y + $h > [winfo rooty .] + [winfo height .]} { lappend outside bottom }
    set outside
} -result {}

test dialog-stays-on-screen {and never leaves the screen} -body {
    lassign [dialogGeometry] x y w h
    list [expr {$x >= 0}] [expr {$y >= 0}] \
         [expr {$x + $w <= [winfo screenwidth .]}] \
         [expr {$y + $h <= [winfo screenheight .]}]
} -result {1 1 1 1}

# showMessage replaced tk_messageBox, which on Windows is the native system
# box: it centres on the screen rather than on the application, ignores the
# application's fonts, and cannot be inspected at all - winfo does not see it,
# so the tests could only stub it out.  Being a real Tk window, this one can be
# driven and measured.

# Opens a message, records what it shows and where, and dismisses it.
proc messageGeometry {icon title text} {
    after 400 {
        update idletasks
        set ::shown [list \
            [winfo exists .message] \
            [.message.text cget -text] \
            [.message.icon cget -bitmap] \
            [wm title .message] \
            [winfo rootx .message] [winfo rooty .message] \
            [winfo reqwidth .message] [winfo reqheight .message]]
        set ::sotalog::messageResult 1
    }
    showMessage $icon $title $text
    return $::shown
}

test message-shows-what-it-was-given {the message, icon and title all appear} -body {
    lassign [messageGeometry warning "No band selected" "Select a band before logging this QSO."] \
        exists text icon title
    list $exists $text $icon $title
} -result {1 {Select a band before logging this QSO.} warning {No band selected}}

test message-is-centred-on-the-main-window {and it opens over the window, not the screen} -body {
    lassign [messageGeometry info "Restart needed" "SOTALog needs to be restarted."] \
        exists text icon title x y w h
    set mainCentreX [expr {[winfo rootx .] + [winfo width .] / 2}]
    set mainCentreY [expr {[winfo rooty .] + [winfo height .] / 2}]
    list [expr {abs(($x + $w / 2) - $mainCentreX) <= 1}] \
         [expr {abs(($y + $h / 2) - $mainCentreY) <= 1}]
} -result {1 1}

test message-is-dismissed {and it goes away once acknowledged} -body {
    messageGeometry error "Update failed" "Something went wrong."
    winfo exists .message
} -result 0

# Which field the operator is typing in when a dialog opens.
#
# Show.Modal used to focus the toplevel, which looks the same on screen but
# swallows the first keystrokes until something is clicked or tabbed to.  Both
# dialogs set the focus themselves before calling it, and it took it away
# again; it now takes the field as an argument.

set ::sotalog::myCall HB9TVK/P
set ::sotalog::utcDate 06/09/2026
set ::sotalog::oneKeyReport 1
set ::sotalog::updated 0
set ::sotalog::s2s ""
loadFakeSummitData

test config-dialog-focuses-the-call {the configuration dialog starts in the call field} -setup {
    destroy .cfg
} -cleanup {
    array unset ::sotalog::bandSelected
} -body {
    after 400 {
        update
        set ::focused [focus]
        set ::sotalog::modalResult 0
    }
    configDialog
    set ::focused
} -result .cfg.call

test s2s-dialog-focuses-the-association {the S2S dialog starts in the association field
    It is the first of the three, and the operator types straight into it.
} -body {
    after 400 {
        update
        set ::focused [focus]
        set ::sotalog::modalResult 0
    }
    s2sDialog
    set ::focused
} -result .s2s.ass

removeSandboxes
cleanupTests
