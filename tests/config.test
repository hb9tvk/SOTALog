# Reading and writing sotalog.conf.
#
# The file is parsed rather than evaluated.  It used to be run through eval,
# which made it a script: a value with a space in it stopped the application
# starting, and a value with a bracket in it was executed.  The activation
# date field has no validation, so either was one keystroke away.

set ::env(TZ) UTC
source [file join [file dirname [info script]] helpers.tcl]
namespace import ::tcltest::*
namespace import ::sotalogtest::*
loadModules
freezeClock 1757073930   ;# so the default activation date is 05/09/2025

# saveConfig reads the two fields of the configuration dialog.  Only those two
# are needed here; building the whole dialog would drag in its modal loop.
toplevel .cfg
entry .cfg.call
entry .cfg.utcDate
wm withdraw .cfg

proc writeConfig {dir contents} {
    set fh [open [file join $dir sotalog.conf] w]
    puts -nonewline $fh $contents
    close $fh
}

set valid "set myCall HB9TVK/P\nset oneKeyReport 1\nset entryMode 1\nset utcDate 05/09/2026\n"

test parse-normal {a well-formed file yields every setting} -body {
    parseConfig $valid
} -result {myCall HB9TVK/P oneKeyReport 1 entryMode 1 utcDate 05/09/2026}

test parse-value-with-spaces {a value containing spaces is kept verbatim} -body {
    dict get [parseConfig "set utcDate 5 September 2026\n"] utcDate
} -result {5 September 2026}

test parse-bracket-is-literal {a bracketed value is text, not something to run} -setup {
    set ::executed 0
} -body {
    set value [dict get [parseConfig "set utcDate \[set ::executed 1\]\n"] utcDate]
    list $value $::executed
} -result {{[set ::executed 1]} 0}

test parse-unknown-setting {a setting that is not ours is ignored} -body {
    dict keys [parseConfig "set myCall HB9TVK\nset somethingElse 42\n"]
} -result myCall

test parse-comments-and-blanks {blank lines and comments are skipped} -body {
    parseConfig "\n# a comment\n\nset myCall HB9TVK\n\n"
} -result {myCall HB9TVK}

test parse-garbage {a line that is not a setting is ignored, not fatal} -body {
    parseConfig "set myCall HB9TVK\nexec something dangerous\nset entryMode 1\n"
} -result {myCall HB9TVK entryMode 1}

test parse-truncated {a file cut off mid-write yields what survived} -body {
    parseConfig "set myCall HB9TVK/P\nset oneKeyRep"
} -result {myCall HB9TVK/P}

test load-normal {a valid file reaches the globals} -setup {
    set ::sotalog::cwd [sandbox]
    writeConfig $::sotalog::cwd $valid
} -body {
    loadConfig
    list $::sotalog::myCall $::sotalog::oneKeyReport $::sotalog::entryMode $::sotalog::utcDate
} -result {HB9TVK/P 1 1 05/09/2026}

test load-spaces-does-not-crash {a date with spaces loads instead of killing startup
    This is the case that used to stop the application: eval saw
    "set utcDate 5 September 2026" as a set with too many arguments.
} -setup {
    set ::sotalog::cwd [sandbox]
    writeConfig $::sotalog::cwd "set myCall HB9TVK/P\nset entryMode 1\nset utcDate 5 September 2026\n"
} -body {
    loadConfig
    list $::sotalog::myCall $::sotalog::utcDate
} -result {HB9TVK/P {5 September 2026}}

test load-bracket-does-not-execute {a bracketed value is not run} -setup {
    set ::sotalog::cwd [sandbox]
    set ::executed 0
    writeConfig $::sotalog::cwd "set myCall HB9TVK/P\nset utcDate \[set ::executed 1\]\n"
} -body {
    loadConfig
    list $::executed $::sotalog::utcDate
} -result {0 {[set ::executed 1]}}

test load-truncated-keeps-defaults {a half-written file falls back rather than failing} -setup {
    set ::sotalog::cwd [sandbox]
    writeConfig $::sotalog::cwd "set myCall HB9XYZ\nset oneKeyRep"
} -body {
    loadConfig
    # myCall survived; everything after the truncation keeps its default.
    list $::sotalog::myCall $::sotalog::oneKeyReport $::sotalog::entryMode $::sotalog::utcDate
} -result {HB9XYZ 1 0 05/09/2025}

test load-missing-settings-keep-defaults {settings absent from the file keep their defaults} -setup {
    set ::sotalog::cwd [sandbox]
    writeConfig $::sotalog::cwd "set entryMode 1\n"
} -body {
    loadConfig
    list $::sotalog::myCall $::sotalog::oneKeyReport $::sotalog::entryMode
} -result {HB9TVK/P 1 1}

test load-missing-file-opens-dialog {a first run with no file asks for one} -setup {
    set ::sotalog::cwd [sandbox]
    # loadConfig calls configDialog from inside ::sotalog, so the stub has to
    # replace the real command there; replacing the imported global alias
    # would leave the namespace resolving to the real dialog.
    rename ::sotalog::configDialog ::sotalog::realConfigDialog
    proc ::sotalog::configDialog {} { set ::dialogOpened 1 }
    set ::dialogOpened 0
} -cleanup {
    rename ::sotalog::configDialog {}
    rename ::sotalog::realConfigDialog ::sotalog::configDialog
} -body {
    loadConfig
    set ::dialogOpened
} -result 1

test save-writes-every-setting {saving produces one line per setting, in order} -setup {
    set ::sotalog::cwd [sandbox]
    set ::sotalog::myCall HB9TVK/P
    set ::sotalog::oneKeyReport 1
    set ::sotalog::entryMode 1
    set ::sotalog::utcDate 05/09/2026
    set ::sotalog::bands {40m 20m}
    array unset ::sotalog::bandSelected
    setEntry .cfg.call HB9TVK/P
    setEntry .cfg.utcDate 05/09/2026
} -body {
    saveConfig
    string trim [readFile [file join $::sotalog::cwd sotalog.conf]]
} -result "set myCall HB9TVK/P
set oneKeyReport 1
set entryMode 1
set utcDate 05/09/2026
set bands 40m 20m"

test save-leaves-no-temp-file {the temporary file used for the atomic write is gone} -setup {
    set ::sotalog::cwd [sandbox]
    setEntry .cfg.call HB9TVK/P
    setEntry .cfg.utcDate 05/09/2026
} -body {
    saveConfig
    lsort [lmap f [glob -nocomplain -directory $::sotalog::cwd *] {file tail $f}]
} -result sotalog.conf

test roundtrip {what saveConfig writes, loadConfig reads back} -setup {
    set ::sotalog::cwd [sandbox]
    set ::sotalog::myCall HB9XYZ/P
    set ::sotalog::oneKeyReport 0
    set ::sotalog::entryMode 1
    set ::sotalog::utcDate 24/12/2026
    setEntry .cfg.call HB9XYZ/P
    setEntry .cfg.utcDate 24/12/2026
} -body {
    saveConfig
    set ::sotalog::myCall ""
    set ::sotalog::oneKeyReport 9
    set ::sotalog::entryMode 9
    set ::sotalog::utcDate ""
    loadConfig
    list $::sotalog::myCall $::sotalog::oneKeyReport $::sotalog::entryMode $::sotalog::utcDate
} -result {HB9XYZ/P 0 1 24/12/2026}

# The band selection.  It is the one setting that names things rather than
# being a number or a string, so it is the one that has to be checked.

test bands-normalise-to-table-order {the selection comes back in master-table order} -body {
    normaliseBands {10m 160m 40m}
} -result {160m 40m 10m}

test bands-unknown-are-dropped {a band the application does not know is ignored} -body {
    normaliseBands {40m 11m 20m}
} -result {40m 20m}

test bands-empty-falls-back {an empty or entirely unknown selection uses the defaults} -body {
    list [normaliseBands {}] [normaliseBands {11m 5m}]
} -result [list $::sotalog::defaultBands $::sotalog::defaultBands]

test bands-load-from-config {a configured selection reaches the band list} -setup {
    set ::sotalog::cwd [sandbox]
    writeConfig $::sotalog::cwd "set myCall HB9TVK/P\nset bands 160m 40m 2m\n"
} -body {
    loadConfig
    set ::sotalog::bands
} -result {160m 40m 2m}

test bands-load-defaults-when-absent {a configuration without the setting keeps the defaults} -setup {
    set ::sotalog::cwd [sandbox]
    writeConfig $::sotalog::cwd "set myCall HB9TVK/P\n"
} -body {
    loadConfig
    set ::sotalog::bands
} -result [set ::sotalog::defaultBands]

test bands-load-rejects-rubbish {an unusable selection falls back rather than emptying the panel} -setup {
    set ::sotalog::cwd [sandbox]
    writeConfig $::sotalog::cwd "set bands 11m nonsense\n"
} -body {
    loadConfig
    set ::sotalog::bands
} -result [set ::sotalog::defaultBands]

test bands-roundtrip {what the dialog ticks survives a save and a load} -setup {
    set ::sotalog::cwd [sandbox]
    set ::sotalog::myCall HB9TVK/P
    set ::sotalog::entryMode 0
    array unset ::sotalog::bandSelected
    # As the checkbuttons would leave it: 2m and 160m ticked, nothing else.
    foreach {wavelength frequency} $::sotalog::allBands {
        set ::sotalog::bandSelected($wavelength) 0
    }
    set ::sotalog::bandSelected(2m) 1
    set ::sotalog::bandSelected(160m) 1
    setEntry .cfg.call HB9TVK/P
} -cleanup {
    array unset ::sotalog::bandSelected
} -body {
    saveConfig
    set ::sotalog::bands {}
    loadConfig
    set ::sotalog::bands
} -result {160m 2m}

test dialog-offers-and-saves-bands {the dialog lists every band and keeps what is ticked
    Drives the real modal dialog.  exit and tk_messageBox are stubbed because
    a band change asks for a restart, and configDialog carries that out by
    calling exit - which would take the test run with it.
} -setup {
    destroy .cfg
    set ::sotalog::cwd [sandbox]
    set ::sotalog::myCall HB9TVK/P
    set ::sotalog::entryMode 0
    set ::sotalog::bands {40m 20m}
    set ::restartRequested 0
    set ::bandButtons 0
    rename ::exit ::realExit
    proc ::exit {args} { set ::restartRequested 1 }
    rename ::tk_messageBox ::realMessageBox
    proc ::tk_messageBox {args} { return ok }
} -cleanup {
    rename ::exit {}
    rename ::realExit ::exit
    rename ::tk_messageBox {}
    rename ::realMessageBox ::tk_messageBox
    array unset ::sotalog::bandSelected
    # Put back the two fields the earlier tests drive saveConfig through.
    destroy .cfg
    toplevel .cfg
    entry .cfg.call
    entry .cfg.utcDate
    wm withdraw .cfg
} -body {
    after 300 {
        foreach {wavelength frequency} $::sotalog::allBands {
            if {[winfo exists .cfg.bands.b$wavelength]} { incr ::bandButtons }
        }
        set ::sotalog::bandSelected(2m) 1
        set ::sotalog::modalResult 1
    }
    configDialog
    list $::bandButtons $::sotalog::bands $::restartRequested
} -result {15 {40m 20m 2m} 1}

test dialog-cancel-keeps-the-selection {cancelling changes nothing} -setup {
    destroy .cfg
    set ::sotalog::cwd [sandbox]
    set ::sotalog::bands {40m 20m}
    set ::sotalog::entryMode 0
} -cleanup {
    array unset ::sotalog::bandSelected
    destroy .cfg
    toplevel .cfg
    entry .cfg.call
    entry .cfg.utcDate
    wm withdraw .cfg
} -body {
    after 300 {
        set ::sotalog::bandSelected(2m) 1
        set ::sotalog::modalResult 0
    }
    configDialog
    set ::sotalog::bands
} -result {40m 20m}

removeSandboxes
cleanupTests
