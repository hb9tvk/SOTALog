# The band list and the KX3 band map have to agree.
#
# They are declared in different files - the list in src/main.tcl, the map in
# src/kx3.tcl - and have drifted apart before: commit 4930184 replaced 6m with
# 60m in the list and left the map alone, so a radio reporting 6m set the band
# to a value nothing else knew.

source [file join [file dirname [info script]] helpers.tcl]
namespace import ::tcltest::*
namespace import ::sotalogtest::*
loadModules

set ::sotalog::bandlist $::sotalogtest::bandlist

# The wavelengths, without the frequencies they alternate with.
proc wavelengths {} {
    set bands {}
    foreach {wl fq} $::sotalog::bandlist { lappend bands $wl }
    return $bands
}

proc mappedBands {} {
    set bands {}
    foreach key [array names ::sotalog::kx32b] { lappend bands $::sotalog::kx32b($key) }
    return [lsort -unique $bands]
}

test every-band-can-be-selected-by-radio {each band in the list has a KX3 command} -body {
    set unmapped {}
    foreach band [wavelengths] {
        if {[lsearch -exact [mappedBands] $band] < 0} { lappend unmapped $band }
    }
    set unmapped
} -result {}

test sixty-metres-is-mapped {60m answers to BN02, the command the radio sends} -body {
    # The key is held in a variable: a semicolon inside an array index would
    # end the command.
    set key "BN02;"
    set ::sotalog::kx32b($key)
} -result 60m

test map-keys-are-five-characters {the keys match what kx3band reads off the port
    kx3band reads exactly five characters, so every key has to be that long,
    semicolon included.
} -body {
    set wrong {}
    foreach key [array names ::sotalog::kx32b] {
        if {[string length $key] != 5} { lappend wrong "$key ([string length $key])" }
    }
    lsort $wrong
} -result {}

test every-mapped-band-is-usable {the map never names a band the log cannot use
    The other direction of the same check.  BN10, which the radio sends for
    6m, is deliberately not in the map: 6m is not in the band list, and adding
    it would mean a ninth row in the band panel and a taller window.
} -body {
    set unusable {}
    foreach band [mappedBands] {
        if {[lsearch -exact [wavelengths] $band] < 0} { lappend unusable "|$band|" }
    }
    set unusable
} -result {}

test unknown-reply-leaves-the-band-alone {a band the map does not cover is ignored
    This is what makes dropping BN10 safe: kx3band checks before it assigns,
    so switching the radio to 6m leaves the band where the operator put it
    rather than setting one nothing else knows.  Driven through a file
    standing in for the serial port.
} -setup {
    set dir [sandbox]
    set path [file join $dir reply]
} -body {
    set results {}
    foreach {reply expected} {BN04; 30m BN10; 40m} {
        set fh [open $path w]
        fconfigure $fh -translation binary
        puts -nonewline $fh $reply
        close $fh

        set ::sotalog::band 40m
        set ::sotalog::serial [open $path r]
        kx3band
        close $::sotalog::serial
        lappend results $::sotalog::band
    }
    set results
} -result {30m 40m}

removeSandboxes
cleanupTests
