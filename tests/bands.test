# The band list and the KX3 band map have to agree.
#
# They are declared in different files - the list in src/main.tcl, the map in
# src/kx3.tcl - and have drifted apart before: commit 4930184 replaced 6m with
# 60m in the list and left the map alone, so a radio reporting 6m set the band
# to a value nothing else knew.

source [file join [file dirname [info script]] helpers.tcl]
namespace import ::tcltest::*
namespace import ::sotalogtest::*
loadModules

set ::sotalog::bands $::sotalog::defaultBands

# The wavelengths, without the frequencies they alternate with.
proc wavelengths {} {
    set bands {}
    foreach wl $::sotalog::bands { lappend bands $wl }
    return $bands
}

proc mappedBands {} {
    set bands {}
    foreach key [array names ::sotalog::kx32b] { lappend bands $::sotalog::kx32b($key) }
    return [lsort -unique $bands]
}

# The wavelengths in the master table, without the frequencies.
proc allWavelengths {} {
    set bands {}
    foreach {wl fq} $::sotalog::allBands { lappend bands $wl }
    return $bands
}

proc mappedBands {} {
    set bands {}
    foreach key [array names ::sotalog::kx32b] { lappend bands $::sotalog::kx32b($key) }
    return [lsort -unique $bands]
}

test map-names-real-bands {every KX3 command names a band the log knows} -body {
    set unknown {}
    foreach band [mappedBands] {
        if {[lsearch -exact [allWavelengths] $band] < 0} { lappend unknown "|$band|" }
    }
    set unknown
} -result {}

test radio-covers-160m-to-6m {the map covers the whole range the KX3 reaches
    Everything above 6m in the band table - 4m, 2m, 70cm, 23cm - needs a
    transverter and is not reported by the radio, so it is chosen by hand.
} -body {
    lsort [mappedBands]
} -result [lsort {160m 80m 60m 40m 30m 20m 17m 15m 12m 10m 6m}]

test map-keys-are-five-characters {the keys match what kx3band reads off the port
    kx3band reads exactly five characters, so every key has to be that long,
    semicolon included.
} -body {
    set wrong {}
    foreach key [array names ::sotalog::kx32b] {
        if {[string length $key] != 5} { lappend wrong "$key ([string length $key])" }
    }
    lsort $wrong
} -result {}

# kx3band is driven through a file standing in for the serial port.
proc radioReports {reply} {
    set path [file join [sandbox] reply]
    set fh [open $path w]
    fconfigure $fh -translation binary
    puts -nonewline $fh $reply
    close $fh
    set ::sotalog::serial [open $path r]
    kx3band
    close $::sotalog::serial
    return $::sotalog::band
}

test radio-selects-a-displayed-band {a reply for a selected band moves the band} -setup {
    set ::sotalog::bands $::sotalog::defaultBands
    set ::sotalog::band 40m
} -body {
    radioReports "BN04;"
} -result 30m

test radio-ignores-an-undisplayed-band {a reply for a band that is not shown is ignored
    160m is in the master table and the radio can report it, but it is not in
    the default selection, so following it would select a band with no button
    and no counter.
} -setup {
    set ::sotalog::bands $::sotalog::defaultBands
    set ::sotalog::band 40m
} -body {
    radioReports "BN00;"
} -result 40m

test radio-follows-a-band-once-selected {and follows it once the operator adds it} -setup {
    set ::sotalog::bands [concat 160m $::sotalog::defaultBands]
    set ::sotalog::band 40m
} -cleanup {
    set ::sotalog::bands $::sotalog::defaultBands
} -body {
    radioReports "BN00;"
} -result 160m

test radio-ignores-an-unknown-reply {a reply that is not a band at all is ignored} -setup {
    set ::sotalog::bands $::sotalog::defaultBands
    set ::sotalog::band 40m
} -body {
    radioReports "BN99;"
} -result 40m

# Reopening a log written on a band that is no longer displayed.  This needs
# the real window, because insertLog updates a counter beside each band and
# there is none for a band that is not shown.

set ::env(TZ) UTC
freezeClock 1757073930
set dir [sandbox]

test hidden-band-still-reloads {a QSO on an unselected band lands on the right band
    The frequency is mapped through the whole band table, not the selection,
    so hiding a band does not corrupt logs that used it.
} -setup {
    # Only two bands displayed; the log below was made on a third.
    set ::sotalog::bands {40m 20m}
    startLogWindow $dir 0
    set fh [open [file join $dir $::sotalog::logfile] w]
    fconfigure $fh -encoding utf-8 -translation lf
    puts $fh {V2,HB9TVK/P,HB/BE-003,05/09/2025,1205,10.1MHz,CW,HB9XYZ,,"RSTS:599 RSTR:579"}
    close $fh
    set ::sotalog::box {}
    initCounter
    .loghist.box delete 0 end
} -body {
    readLog
    list $::sotalog::band [llength $::sotalog::box] $::sotalog::qsocount(30m)
} -result {30m 1 1}

test unknown-frequency-leaves-the-band-alone {a frequency not in the table is ignored} -setup {
    set fh [open [file join $dir $::sotalog::logfile] w]
    fconfigure $fh -encoding utf-8 -translation lf
    puts $fh {V2,HB9TVK/P,HB/BE-003,05/09/2025,1205,99MHz,CW,G0XYZ,,""}
    close $fh
    set ::sotalog::band 40m
    set ::sotalog::box {}
    initCounter
    .loghist.box delete 0 end
} -body {
    readLog
    list $::sotalog::band [llength $::sotalog::box]
} -result {40m 1}

# Starting with no band chosen.
#
# Entering QSOs at home after an activation, the band is easy to forget, and
# one silently left at a default is worse than being asked for it.
test saving-without-a-band-is-refused {logging without a band asks for one
    tk_messageBox is stubbed: the real one would wait for a click.
} -setup {
    set ::sotalog::band ""
    set ::warned 0
    rename ::tk_messageBox ::realMessageBox
    proc ::tk_messageBox {args} { set ::warned 1; return ok }
    setEntry .sotalog.call HB9XYZ
    setEntry .sotalog.rsts 599
    setEntry .sotalog.rstr 579
    setEntry .sotalog.rem ""
    set ::sotalog::box {}
} -cleanup {
    rename ::tk_messageBox {}
    rename ::realMessageBox ::tk_messageBox
} -body {
    saveLog
    # Warned, nothing logged, and what was typed is still there to retry with.
    list $::warned [llength $::sotalog::box] [.sotalog.call get] [.sotalog.rsts get]
} -result {1 0 HB9XYZ 599}

test saving-with-a-band-still-works {choosing a band and pressing Return again logs it} -setup {
    set ::sotalog::band 40m
    set ::sotalog::mode CW
    set ::sotalog::box {}
    initCounter
    .loghist.box delete 0 end
    setEntry .sotalog.call HB9XYZ
    setEntry .sotalog.rsts 599
    setEntry .sotalog.rstr 579
    setEntry .sotalog.rem ""
} -body {
    saveLog
    list [llength $::sotalog::box] [.sotalog.call get]
} -result {1 {}}

test empty-call-still-just-clears {an empty form is not nagged about the band} -setup {
    set ::sotalog::band ""
    set ::warned 0
    rename ::tk_messageBox ::realMessageBox
    proc ::tk_messageBox {args} { set ::warned 1; return ok }
    setEntry .sotalog.call ""
    setEntry .sotalog.rem "leftover"
} -cleanup {
    rename ::tk_messageBox {}
    rename ::realMessageBox ::tk_messageBox
} -body {
    saveLog
    list $::warned [.sotalog.rem get]
} -result {0 {}}

test band-switch-from-nothing {Page Down and Page Up both pick a band when none is set} -setup {
    set ::sotalog::bands $::sotalog::defaultBands
} -body {
    set ::sotalog::band ""
    bandSwitch 1
    set up $::sotalog::band
    set ::sotalog::band ""
    bandSwitch 0
    list $up $::sotalog::band
} -result {60m 10m}

removeSandboxes
cleanupTests
