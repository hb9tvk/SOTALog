# What saveLog writes, and what readLog gets back.
#
# The CSV and the ADIF export are the application's real output contract -
# other people's logging software reads them - so they are pinned here
# byte-for-byte before any of this code is moved around.
#
# The clock is frozen and TZ is fixed to UTC, because saveLog stamps the CSV
# with a local date next to a UTC time.

set ::env(TZ) UTC
source [file join [file dirname [info script]] helpers.tcl]
namespace import ::tcltest::*
namespace import ::sotalogtest::*
loadModules
freezeClock 1757073930   ;# 2025-09-05 12:05:30 UTC

set dir [sandbox]
startLogWindow $dir 0

# The window now opens with no band chosen; these tests are about what reaches
# the log files, so pick one as the operator would.
set ::sotalog::band 40m

test filenames {the log file is named for the date and the summit reference} -body {
    list $::sotalog::logfile $::sotalog::adif
} -result {2025-09-05_HB_BE-003.csv 2025-09-05_HB_BE-003.adi}

test csv-plain {a QSO with both reports and a remark} -body {
    logQso call HB9XYZ rsts 599 rstr 579 rem "nice sig"
    string trim [readFile [file join $dir $::sotalog::logfile]]
} -result {V2,HB9TVK/P,HB/BE-003,05/09/2025,1205,7.0MHz,CW,HB9XYZ,,"RSTS:599 RSTR:579 nice sig"}

test adif-plain {the matching ADIF record} -body {
    lindex [adifRecords [file join $dir $::sotalog::adif]] 0
} -result {<CALL:6>HB9XYZ <MODE:2>CW <BAND:3>40m <QSO_DATE:8>20250905 <TIME_ON:6>120500 <RST_RCVD:3>579 <RST_SENT:3>599 <STATION_CALLSIGN:8>HB9TVK/P <OPERATOR:8>HB9TVK/P <MY_SOTA_REF:9>HB/BE-003 <COMMENT:8>nice sig <EOR>}

test csv-summit-to-summit {an S2S contact carries the far summit in its own column and in the remark} -setup {
    set ::sotalog::s2s HB/VS-001
} -cleanup {
    set ::sotalog::s2s ""
} -body {
    logQso call DL1ABC rsts 559 rstr 339
    lindex [split [string trim [readFile [file join $dir $::sotalog::logfile]]] \n] 1
} -result {V2,HB9TVK/P,HB/BE-003,05/09/2025,1205,7.0MHz,CW,DL1ABC,HB/VS-001,"RSTS:559 RSTR:339 S2S:HB/VS-001"}

test adif-summit-to-summit {the worked summit goes in SOTA_REF, which is what the database reads} -body {
    lindex [adifRecords [file join $dir $::sotalog::adif]] 1
} -result {<CALL:6>DL1ABC <MODE:2>CW <BAND:3>40m <QSO_DATE:8>20250905 <TIME_ON:6>120500 <RST_RCVD:3>339 <RST_SENT:3>559 <STATION_CALLSIGN:8>HB9TVK/P <OPERATOR:8>HB9TVK/P <MY_SOTA_REF:9>HB/BE-003 <SOTA_REF:9>HB/VS-001 <EOR>}

test csv-bare {a QSO with no reports and no remark still logs the call} -body {
    logQso call G0XYZ
    lindex [split [string trim [readFile [file join $dir $::sotalog::logfile]]] \n] 2
} -result {V2,HB9TVK/P,HB/BE-003,05/09/2025,1205,7.0MHz,CW,G0XYZ,,""}

test adif-empty-rst {a QSO with no reports omits the report fields entirely} -body {
    lindex [adifRecords [file join $dir $::sotalog::adif]] 2
} -result {<CALL:5>G0XYZ <MODE:2>CW <BAND:3>40m <QSO_DATE:8>20250905 <TIME_ON:6>120500 <STATION_CALLSIGN:8>HB9TVK/P <OPERATOR:8>HB9TVK/P <MY_SOTA_REF:9>HB/BE-003 <EOR>}


test empty-call-is-ignored {pressing Return on an empty call logs nothing} -body {
    set before [llength [split [string trim [readFile [file join $dir $::sotalog::logfile]]] \n]]
    logQso call ""
    set after [llength [split [string trim [readFile [file join $dir $::sotalog::logfile]]] \n]]
    list $before $after
} -result {3 3}

test display-rows {the on-screen log shows newest first, S2S replacing the remark} -body {
    set ::sotalog::box
} -result [list \
    "1205   G0XYZ                                                       " \
    "1205   DL1ABC              559       339       HB/VS-001           " \
    "1205   HB9XYZ              599       579       nice sig            "]

test qso-counter {all three QSOs are counted against 40m} -body {
    set ::sotalog::qsocount(40m)
} -result 3

test reload-preserves-rows {reopening the log restores every QSO} -setup {
    set ::sotalog::box {}
    initCounter
    .loghist.box delete 0 end
} -body {
    readLog
    list [llength $::sotalog::box] $::sotalog::qsocount(40m)
} -result {3 3}

test reload-parses-remark-column {reloading splits the reports back out of the remark} -setup {
    set ::sotalog::box {}
    initCounter
    .loghist.box delete 0 end
} -body {
    readLog
    # $::sotalog::box is newest-first; row 1 is the S2S QSO whose remark follows RSTR.
    list [string trim [lindex $::sotalog::box 2]] [string trim [lindex $::sotalog::box 1]]
} -result {{1205   HB9XYZ              599       579       nice sig} {1205   DL1ABC              559       339       S2S:HB/VS-001}}

# Logged last, because it adds a fourth QSO and the tests above count three.
test adif-short-report {a two-character SSB report declares a length of two} -body {
    logQso call PA0ABC rsts 59 rstr 57
    lindex [adifRecords [file join $dir $::sotalog::adif]] 3
} -result {<CALL:6>PA0ABC <MODE:2>CW <BAND:3>40m <QSO_DATE:8>20250905 <TIME_ON:6>120500 <RST_RCVD:2>57 <RST_SENT:2>59 <STATION_CALLSIGN:8>HB9TVK/P <OPERATOR:8>HB9TVK/P <MY_SOTA_REF:9>HB/BE-003 <EOR>}


# tcltest exits from cleanupTests with a zero status whatever happened, so
# tools/test.tcl decides pass or fail by reading the summary line below.
test adif-header-appears-once {the header is written when the file is created, not per QSO
    The records are appended one at a time as QSOs are logged, so the header
    has to be written only when the file does not yet exist - a second one part
    way through the file would make it unreadable.
} -body {
    set text [readFile [file join $dir $::sotalog::adif]]
    list [regexp -all {<EOH>} [string toupper $text]] \
         [regexp -all {<EOR>} [string toupper $text]]
} -result {1 4}

test adif-header-comes-first {and it is at the top of the file} -body {
    set first [lindex [split [readFile [file join $dir $::sotalog::adif]] \n] 0]
    string match "ADIF export from SOTALog:*" $first
} -result 1

test adif-every-record-names-the-summit {every record carries MY_SOTA_REF} -body {
    set without {}
    foreach record [adifRecords [file join $dir $::sotalog::adif]] {
        if {![string match "*<MY_SOTA_REF:9>HB/BE-003*" $record]} { lappend without $record }
    }
    llength $without
} -result 0

removeSandboxes
cleanupTests
